{
  "name": "dsh-im-indicator",
  "version": "0.1.2",
  "type": "module",
  "description": "Lightweight DSH session-list indicator: a channel capsule on the Session each IM channel is driving, plus a running/unread dot for every Session. Zero runtime dependencies.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Poy-Coder/dsh-im-indicator.git" },
  "homepage": "https://github.com/Poy-Coder/dsh-im-indicator#readme",
  "bugs": { "url": "https://github.com/Poy-Coder/dsh-im-indicator/issues" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "im", "feishu", "wechat", "indicator", "sidebar"],
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "test/verify.mjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "test": "node --test test/verify.mjs"
  }
}
